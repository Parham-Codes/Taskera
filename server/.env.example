# Server Port & Environment
PORT=7000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/taskera

# JWT Authentication Secrets (Mandatory - Server halts if undefined)
# Generate 64-char hex strings via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_secure_jwt_access_secret_key_min_32_characters
JWT_REFRESH_SECRET=your_secure_jwt_refresh_secret_key_min_32_characters

# Optional: System Default Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Internal Reminder Trigger Secret
# Required for external schedulers (e.g. GitHub Actions) to authenticate against POST /api/internal/reminders/run
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
REMINDER_TRIGGER_SECRET=your_secure_internal_reminder_trigger_secret_min_32_characters

# In-Process Reminder Scheduler Toggle
# Set to 'false' in production/cloud environments (e.g. Render) to avoid duplicate cycles when using external schedulers
# Defaults to 'true' for local development
ENABLE_REMINDER_SCHEDULER=true
