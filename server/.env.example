# Server Port & Environment
PORT=7000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/taskera

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here

# Optional: System Default Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
